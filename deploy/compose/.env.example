# Copy to .env (make setup does it). .env is git-ignored. Never commit real secrets.
# These are LOCAL development values only. Production values live in an env file on the server.

POSTGRES_SUPERUSER_PASSWORD=dev-superuser-change-me

# One app login and one migrator login per service database. Same dev password everywhere locally.
DB_APP_PASSWORD=dev-app-pass
DB_MIGRATOR_PASSWORD=dev-migrator-pass

# Services read their own settings from these (see libs/common/config.py)
ENVIRONMENT=local
LOG_LEVEL=INFO
JWKS_URL=http://identity:8000/.well-known/jwks.json
ACCESS_URL=http://access:8000
HIERARCHY_URL=http://hierarchy:8000
TASKS_URL=http://tasks:8000
TIME_URL=http://time:8000

# identity: token signing key. Empty is allowed ONLY when ENVIRONMENT=local (a throw-away key is generated
# at each start, so tokens die on restart). For anything shared:  python tools/gen_signing_key.py
SIGNING_PRIVATE_KEY=

# Browser origins allowed to call the API (comma separated), e.g. http://localhost:5173
CORS_ORIGINS=
