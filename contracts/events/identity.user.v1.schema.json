{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "identity.user.v1.schema.json",
  "title": "Topic identity.user.v1 (global Kafka; key = user id): identity.user.created | updated. Never carries password material.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "identity.user.created",
            "identity.user.updated"
          ]
        },
        "aggregate_type": {
          "const": "user"
        },
        "data": {
          "type": "object",
          "required": [
            "after"
          ],
          "properties": {
            "after": {
              "type": "object",
              "required": [
                "id",
                "version",
                "email",
                "display_name",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "version": {
                  "type": "integer"
                },
                "email": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                },
                "initials": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "active",
                    "suspended"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
